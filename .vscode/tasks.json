{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Project (Same as Desktop Shortcut)",
            "type": "shell",
            "command": "cmd.exe",
            "args": ["/c", "${workspaceFolder}\\scripts\\launch_gtae_ids.bat"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Review-II Demo Only",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["scripts/run_review2_demo.py"],
            "problemMatcher": []
        },
        {
            "label": "Run Flask Web App Only",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["app.py"],
            "problemMatcher": []
        }
    ]
}
